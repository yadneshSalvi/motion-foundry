# Copy to .env for local use. Keep real credentials in backend environment variables.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides; these are the tested defaults.
OPENAI_MODEL=gpt-6.1-sol
GEMINI_MODEL=gemini-4-argon
# Required in production. Use a random secret of at least 32 characters.
MOTION_SIGNING_SECRET=
# Populate after deploying the HTTPS backend.
BACKEND_BASE_URL=
